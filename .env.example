# Copy to .env and fill in real values. Never commit .env.

# ---- Database ----
DB_HOST=db
DB_PORT=5432
DB_NAME=bd_franklin_rodriguez_thompson
DB_USER=rw_app
DB_PASSWORD=change_me
# Superuser used only for running migrations (owns schema, app role does not).
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=change_me_too

# ---- Backend ----
NODE_ENV=development
PORT=4000
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000
CORRELATION_ID_HEADER=X-Correlation-Id

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ---- AI Copilot ----
# Any OpenAI-compatible API works; OPENAI_BASE_URL picks the vendor.
# OpenAI itself:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_CHAT_MODEL=gpt-4o-mini
#   OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#   COPILOT_MIN_SIMILARITY=0.2
# Google Gemini (AI Studio key) via its OpenAI-compatible endpoint:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_CHAT_MODEL=gemini-3.6-flash
#   OPENAI_EMBEDDING_MODEL=gemini-embedding-001
#   COPILOT_MIN_SIMILARITY=0.5
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match vector(1536) in rw_messages.
OPENAI_EMBEDDING_DIMENSIONS=1536
# Retrieval cutoff; model-dependent, see the two presets above.
COPILOT_MIN_SIMILARITY=0.2

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
